; Rodin Essential offline image integration. Merge into a loaded policy file.
; This fragment requires the Xiaomi Rodin vendor labels; compile the full ROM.
(type rodin_daemon)
(type rodin_daemon_exec)
(type rodin_daemon_data_file)
(type rodin_app)
(type rodin_app_userfaultfd)
(typeattribute rodin_app_userfaultfd_others)
(typeattribute rodin_app_ptrace_forbidden)
(type sysfs_rodin_mali_devfreq)
(type sysfs_rodin_touch)
(type sysfs_rodin_subsystem)
(type sysfs_rodin_subsystem_floor)
(roletype object_r rodin_daemon)
(roletype object_r rodin_daemon_exec)
(roletype object_r rodin_daemon_data_file)
(roletype object_r rodin_app)
(roletype object_r rodin_app_userfaultfd)
(roletype object_r sysfs_rodin_mali_devfreq)
(roletype object_r sysfs_rodin_touch)
(roletype object_r sysfs_rodin_subsystem)
(roletype object_r sysfs_rodin_subsystem_floor)
(typeattributeset domain (rodin_daemon rodin_app))
(typeattributeset coredomain (rodin_daemon rodin_app))
(typeattributeset mlstrustedsubject (rodin_daemon))
(typeattributeset appdomain (rodin_app))
(typeattributeset untrusted_app_all (rodin_app))
(typeattributeset netdomain (rodin_app))
(typeattributeset exec_type (rodin_daemon_exec))
(typeattributeset file_type (rodin_daemon_exec rodin_daemon_data_file))
(typeattributeset system_file_type (rodin_daemon_exec))
(typeattributeset data_file_type (rodin_daemon_data_file))
(typeattributeset core_data_file_type (rodin_daemon_data_file))
(typeattributeset fs_type (sysfs_rodin_mali_devfreq sysfs_rodin_touch))
(typeattributeset sysfs_type (sysfs_rodin_mali_devfreq sysfs_rodin_touch))
(typeattributeset fs_type (sysfs_rodin_subsystem sysfs_rodin_subsystem_floor))
(typeattributeset sysfs_type (sysfs_rodin_subsystem sysfs_rodin_subsystem_floor))

; Equivalent app_domain essentials; Android's existing app rules still apply.
(typetransition rodin_app tmpfs file appdomain_tmpfs)
(allow rodin_app appdomain_tmpfs (file (execute getattr map read write ioctl)))
(allowx rodin_app appdomain_tmpfs (ioctl file ((range 0x7701 0x770b))))
(typetransition rodin_app rodin_app anon_inode "[userfaultfd]" rodin_app_userfaultfd)
(allow rodin_app rodin_app_userfaultfd (anon_inode (create ioctl read)))
(typeattributeset rodin_app_userfaultfd_others (and (domain) (not (rodin_app))))
(typeattributeset rodin_app_ptrace_forbidden (and (domain) (not (rodin_app crash_dump runas_app simpleperf))))
(neverallow rodin_app_userfaultfd_others rodin_app_userfaultfd (anon_inode (create ioctl read)))
(neverallow rodin_app_ptrace_forbidden rodin_app (process (ptrace)))

; Init startup, owned state and the certificate-bound app control socket.
(typetransition init rodin_daemon_exec process rodin_daemon)
(allow init rodin_daemon (process (transition rlimitinh siginh)))
(allow init rodin_daemon_exec (file (getattr open read execute map)))
(allow rodin_daemon rodin_daemon_exec (file (entrypoint getattr open read execute map)))
(allow rodin_app rodin_daemon (unix_stream_socket (connectto)))
(allow rodin_daemon self (unix_stream_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
(allow rodin_daemon self (capability (dac_override sys_admin sys_nice sys_ptrace)))
(allow rodin_daemon self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))
(allow rodin_daemon rodin_daemon_data_file (dir (ioctl read write create getattr setattr lock rename add_name remove_name reparent search open rmdir)))
(allow rodin_daemon rodin_daemon_data_file (file (ioctl read write create getattr setattr lock append map unlink link rename open)))

; Framework commands, including output pipe/FD replies.
(allow rodin_daemon servicemanager (binder (call transfer)))
(allow servicemanager rodin_daemon (binder (call transfer)))
(allow servicemanager rodin_daemon (dir (search)))
(allow servicemanager rodin_daemon (file (read open)))
(allow servicemanager rodin_daemon (process (getattr)))
(allow rodin_daemon system_server (binder (call transfer)))
(allow system_server rodin_daemon (binder (transfer)))
(allow rodin_daemon system_server (fd (use)))
(allow system_server rodin_daemon (fd (use)))
(allow system_server rodin_daemon (fifo_file (write)))
(allow rodin_daemon display_service (service_manager (find)))
(allow rodin_daemon power_service (service_manager (find)))
(allow rodin_daemon settings_service (service_manager (find)))
(allow rodin_daemon window_service (service_manager (find)))
(allow rodin_daemon activity_service (service_manager (find)))
(allow rodin_daemon package_service (service_manager (find)))
; Passive foreground event stream for Per-App Controls.
(allow rodin_daemon logd (unix_stream_socket (connectto)))
(allow rodin_daemon logdr_socket (sock_file (read write open getattr)))
(allow rodin_daemon overlay_service (service_manager (find)))
(allow rodin_daemon system_file (file (getattr open read execute map execute_no_trans)))
(allow rodin_daemon toolbox_exec (file (getattr open read execute map execute_no_trans)))

; Hardware nodes. No generic sysfs file write permission.
(allow rodin_daemon sysfs (dir (search)))
(allow rodin_daemon sysfs_devices_system_cpu (dir (search getattr open read)))
(allow rodin_daemon sysfs_devices_system_cpu (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_devices_block (dir (search getattr open read)))
(allow rodin_daemon sysfs_devices_block (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_memory (dir (search getattr open read)))
(allow rodin_daemon sysfs_memory (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_ged (dir (search getattr open read)))
(allow rodin_daemon sysfs_ged (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_mali_power_policy (dir (search getattr open read)))
(allow rodin_daemon sysfs_mali_power_policy (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_therm (dir (search getattr open read)))
(allow rodin_daemon sysfs_therm (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_usb_supply (dir (search getattr open read)))
(allow rodin_daemon sysfs_usb_supply (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_battery_supply (dir (search getattr open read)))
(allow rodin_daemon sysfs_battery_supply (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_zram (dir (search getattr open read)))
(allow rodin_daemon sysfs_zram (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_fs_f2fs (dir (search getattr open read)))
(allow rodin_daemon sysfs_fs_f2fs (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_blockio (dir (search getattr open read)))
(allow rodin_daemon sysfs_blockio (file (read write getattr open ioctl lock map)))
; Screen-state detection has a framework power-service fallback. Do not grant
; coredomain access to generic LED files, forbidden by the stock platform.
(allow rodin_daemon vendor_sysfs_displayfeature (dir (search getattr open read)))
(allow rodin_daemon vendor_sysfs_displayfeature (file (read getattr open ioctl lock map)))
(allow rodin_daemon proc_powerhal_cpu_ctrl (file (read write getattr open ioctl lock map)))
(allow rodin_daemon proc_touch_boost (file (read write getattr open ioctl lock map)))
(allow rodin_daemon proc_tp_file (file (read getattr open ioctl lock map)))
(allow rodin_daemon proc_swappiness (file (read write getattr open ioctl lock map)))
(allow rodin_daemon proc_drop_caches (file (write open getattr)))
(allow rodin_daemon input_device (chr_file (read write getattr open ioctl lock map)))
(allow rodin_daemon swap_block_device (blk_file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_rodin_mali_devfreq (dir (search getattr open read)))
(allow rodin_daemon sysfs_rodin_mali_devfreq (file (read write getattr open ioctl lock map)))
(allow rodin_daemon sysfs_rodin_touch (dir (search getattr open read)))
(allow rodin_daemon sysfs_rodin_touch (file (read write getattr open ioctl lock map)))
(genfscon sysfs "/devices/platform/soc/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_rodin_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_rodin_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/goodix_ts.0" (u object_r sysfs_rodin_touch ((s0) (s0))))

; Subsystem metadata is read-only; requests are confined to min_freq/max_freq.
(allow rodin_daemon sysfs_rodin_subsystem (dir (search getattr open read)))
(allow rodin_daemon sysfs_rodin_subsystem (file (read getattr open)))
(allow rodin_daemon sysfs_rodin_subsystem_floor (file (read write getattr open)))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq" (u object_r sysfs_rodin_subsystem ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq" (u object_r sysfs_rodin_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq" (u object_r sysfs_rodin_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci" (u object_r sysfs_rodin_subsystem ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/min_freq" (u object_r sysfs_rodin_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/max_freq" (u object_r sysfs_rodin_subsystem_floor ((s0) (s0))))

; Xiaomi vendor services and narrowly scoped native THP timing access.
(allow rodin_daemon vendor_hal_displayfeature_xiaomi_service (service_manager (find)))
(allow rodin_daemon vendor_hal_displayfeature_xiaomi_default (binder (call transfer)))
(allow vendor_hal_displayfeature_xiaomi_default rodin_daemon (binder (transfer)))
(allow rodin_daemon vendor_hal_displayfeature_xiaomi_default (fd (use)))
(allow rodin_daemon hal_touchfeature_xiaomi_service (service_manager (find)))
(allow rodin_daemon hal_touchfeature_xiaomi_default (binder (call transfer)))
(allow hal_touchfeature_xiaomi_default rodin_daemon (binder (transfer)))
(allow rodin_daemon hal_touchfeature_xiaomi_default (fd (use)))
(allow rodin_daemon hal_touchfeature_xiaomi_default (process (ptrace)))
(allow rodin_daemon hal_touchfeature_xiaomi_default (dir (search)))
(allow rodin_daemon hal_touchfeature_xiaomi_default (file (getattr open read write)))
