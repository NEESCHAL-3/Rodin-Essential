# Mali devfreq appears below /platform/soc on current Rodin and below
# /platform on some vendor ports.
genfscon sysfs /devices/platform/soc/13000000.mali/devfreq/13000000.mali u:object_r:sysfs_rodin_mali_devfreq:s0
genfscon sysfs /devices/platform/13000000.mali/devfreq/13000000.mali u:object_r:sysfs_rodin_mali_devfreq:s0

# Goodix fallback used when a port omits Xiaomi's TouchFeature service.
genfscon sysfs /devices/platform/goodix_ts.0 u:object_r:sysfs_rodin_touch:s0
