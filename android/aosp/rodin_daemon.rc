service rodin_daemon /product/bin/rodin_daemon
    class late_start
    user root
    group root system graphics wakelock
    capabilities SYS_ADMIN SYS_NICE
    priority -10
    oom_score_adjust -900
    setenv RODIN_STATE_DIR /data/system/rodin-essential
    # ROM-native touch stays on the public HAL. The root-module-only private
    # target capability is intentionally absent from this service environment.
    disabled
    restart_period 2

on post-fs-data
    restorecon /product/bin/rodin_daemon
    mkdir /data/system/rodin-essential 0700 root root
    restorecon_recursive /data/system/rodin-essential

on property:sys.boot_completed=1
    start rodin_daemon
