(typeattributeset halserverdomain (rodin_touch_hal_release_probe))

(type rodin_display_hal_release_probe)
(typeattributeset domain (rodin_display_hal_release_probe))
(typeattributeset halserverdomain (rodin_display_hal_release_probe))

(type rodin_hal_service_release_probe)
(typeattributeset service_manager_type (rodin_hal_service_release_probe))
(typeattributeset protected_service (rodin_hal_service_release_probe))
(typeattributeset hal_service_type (rodin_hal_service_release_probe))

(allow rodin_daemon_release_probe self (capability (sys_admin sys_nice)))
(allow rodin_daemon_release_probe self (unix_stream_socket
    (create ioctl read getattr write setattr lock append bind connect listen
     accept getopt setopt shutdown map)))

(allow rodin_daemon_release_probe rodin_daemon_data_release_probe
    (dir (add_name create getattr ioctl lock open read remove_name search
          setattr write)))
(allow rodin_daemon_release_probe rodin_daemon_data_release_probe
    (file (append create getattr ioctl lock map open read rename setattr unlink
           write)))

(allow rodin_app_release_probe rodin_daemon_release_probe
    (unix_stream_socket (connectto)))

(allow rodin_daemon_release_probe sysfs (dir (search)))
(allow rodin_daemon_release_probe rodin_mali_devfreq_release_probe (dir (getattr search open read)))
(allow rodin_daemon_release_probe rodin_mali_devfreq_release_probe (file (getattr open read write ioctl lock map)))
(allow rodin_daemon_release_probe rodin_battery_supply_release_probe (file (getattr open read ioctl lock map)))

(allow rodin_daemon_release_probe rodin_sysfs_rw_release_probe
    (dir (getattr open read search)))
(allow rodin_daemon_release_probe rodin_sysfs_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow rodin_daemon_release_probe rodin_proc_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow rodin_daemon_release_probe rodin_swap_block_release_probe
    (blk_file (getattr ioctl lock map open read write)))

(allow rodin_daemon_release_probe rodin_touch_hal_release_probe
    (binder (call transfer)))
(allow rodin_touch_hal_release_probe rodin_daemon_release_probe
    (binder (transfer)))
(allow rodin_daemon_release_probe rodin_touch_hal_release_probe (fd (use)))

(allow rodin_daemon_release_probe rodin_display_hal_release_probe
    (binder (call transfer)))
(allow rodin_display_hal_release_probe rodin_daemon_release_probe
    (binder (transfer)))
(allow rodin_daemon_release_probe rodin_display_hal_release_probe (fd (use)))
(allow rodin_daemon_release_probe rodin_hal_service_release_probe
    (service_manager (find)))

(allow rodin_daemon_release_probe system_server (binder (call transfer)))
(allow system_server rodin_daemon_release_probe (binder (transfer)))
(allow rodin_daemon_release_probe system_server (fd (use)))
(allow system_server rodin_daemon_release_probe (fd (use)))
(allow system_server rodin_daemon_release_probe (fifo_file (write)))
(allow rodin_daemon_release_probe display_service (service_manager (find)))
(allow rodin_daemon_release_probe power_service (service_manager (find)))
(allow rodin_daemon_release_probe settings_service (service_manager (find)))
(allow rodin_daemon_release_probe window_service (service_manager (find)))
(allow rodin_daemon_release_probe system_file
    (file (execute execute_no_trans getattr map open read)))
(allow rodin_daemon_release_probe toolbox_exec
    (file (execute execute_no_trans getattr map open read)))
