(type rodin_daemon_release_probe)
(typeattributeset domain (rodin_daemon_release_probe))
(typeattributeset coredomain (rodin_daemon_release_probe))
(typeattributeset mlstrustedsubject (rodin_daemon_release_probe))

(type rodin_app_release_probe)
(typeattributeset domain (rodin_app_release_probe))
(typeattributeset coredomain (rodin_app_release_probe))
(typeattributeset appdomain (rodin_app_release_probe))
(typeattributeset untrusted_app_all (rodin_app_release_probe))

(type rodin_daemon_data_release_probe)
(typeattributeset file_type (rodin_daemon_data_release_probe))
(typeattributeset data_file_type (rodin_daemon_data_release_probe))
(typeattributeset core_data_file_type (rodin_daemon_data_release_probe))

(type rodin_mali_devfreq_release_probe)
(typeattributeset fs_type (rodin_mali_devfreq_release_probe))
(typeattributeset sysfs_type (rodin_mali_devfreq_release_probe))

(type rodin_battery_supply_release_probe)
(typeattributeset fs_type (rodin_battery_supply_release_probe))
(typeattributeset sysfs_type (rodin_battery_supply_release_probe))

(type rodin_sysfs_rw_release_probe)
(typeattributeset fs_type (rodin_sysfs_rw_release_probe))
(typeattributeset sysfs_type (rodin_sysfs_rw_release_probe))

(type rodin_proc_rw_release_probe)
(typeattributeset fs_type (rodin_proc_rw_release_probe))
(typeattributeset proc_type (rodin_proc_rw_release_probe))

(type rodin_swap_block_release_probe)
(typeattributeset dev_type (rodin_swap_block_release_probe))

(type rodin_touch_hal_release_probe)
